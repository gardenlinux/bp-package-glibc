version_orig=2.41-7
version=2.41-12+deb13u4
version_suffix=gl0~bp1877

apt_src glibc=$version_orig

DEBIAN_SRC=$(mktemp -d)
git clone -b "debian/$version" --depth=1 "https://salsa.debian.org/glibc-team/glibc.git" "$DEBIAN_SRC"
pushd "$DEBIAN_SRC"
git sparse-checkout set debian
popd

cp -rp "$DEBIAN_SRC/debian" "$dir/src/"
rm -fR "$DEBIAN_SRC"

import_upstream_patches
